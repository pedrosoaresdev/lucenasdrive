{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "5e3674e5-2ce2-4b22-ae92-801cc2ff2642"
  },
  "newProjectRoot": "projects",
  "projects": {
    "passenger": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/passenger",
      "sourceRoot": "projects/passenger/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/passenger/src/main.ts",
            "tsConfig": "projects/passenger/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/passenger/public"
              },
              {
                "glob": "firebase-messaging-sw.js",
                "input": "projects/shared/src/assets",
                "output": "/"
              }
            ],
            "styles": [
              "node_modules/leaflet/dist/leaflet.css",
              "projects/shared/src/lib/styles/lucena.css",
              "projects/passenger/src/styles.css"
            ],
            "allowedCommonJsDependencies": [
              "leaflet"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.2MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "12kB"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "projects/passenger/ngsw-config.json",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "projects/passenger/src/environments/environment.ts",
                  "with": "projects/passenger/src/environments/environment.development.ts"
                }
              ]
            },
            "homolog": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "projects/passenger/src/environments/environment.ts",
                  "with": "projects/passenger/src/environments/environment.homolog.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "passenger:build:production"
            },
            "development": {
              "buildTarget": "passenger:build:development"
            },
            "homolog": {
              "buildTarget": "passenger:build:homolog"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4200
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
