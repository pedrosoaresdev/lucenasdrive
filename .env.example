# ============================================================================
# Lucena Drive — variáveis de ambiente (EXEMPLO, sem segredos reais)
# Copie para .env e preencha. Nunca versione o .env nem credenciais.
# ============================================================================

# --- Firebase / Google Cloud -------------------------------------------------
FIREBASE_PROJECT_ID=demo-lucena-drive
FIREBASE_STORAGE_BUCKET=demo-lucena-drive.appspot.com
# true somente com Firebase Emulator Suite (desenvolvimento)
FIREBASE_USE_EMULATORS=true
# Produção: caminho do JSON da conta de serviço OU vazio para Application Default Credentials
GOOGLE_APPLICATION_CREDENTIALS=

# --- Segurança (gere valores aleatórios de 32 bytes em base64) ---------------
# openssl rand -base64 32
LUCENA_DATA_ENCRYPTION_KEY=
LUCENA_ADMIN_MFA_TOKEN_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202
REQUIRE_VERIFIED_EMAIL=true

# --- Provisionamento do proprietário (use uma vez e remova) -------------------
# A conta deve existir no Firebase Auth. CPF é validado e armazenado criptografado.
LUCENA_BOOTSTRAP_OWNER_EMAIL=
LUCENA_BOOTSTRAP_OWNER_CPF=
LUCENA_BOOTSTRAP_OWNER_NAME=

# --- Google Maps Platform ------------------------------------------------------
# Chave de SERVIDOR (Routes API), restrita por IP e por API. Nunca vai para o navegador.
MAPS_SERVER_API_KEY=
# Somente desenvolvimento: estimativa em linha reta quando não há chave (sinalizada na UI)
MAPS_ALLOW_STRAIGHT_LINE_FALLBACK=true
# Distância máxima (m) entre o motorista e o embarque para marcar "Cheguei" (0 desativa)
DISPATCH_MAX_ARRIVAL_METERS=500

# --- Pagamentos (provedor a contratar) ------------------------------------------
PAYMENTS_PROVIDER=none
PAYMENTS_API_KEY=
PAYMENTS_WEBHOOK_SECRET=
PAYMENTS_ENVIRONMENT=sandbox

# --- Execução -----------------------------------------------------------------
PORT=8080
LOG_FORMAT=logstash
SWAGGER_ENABLED=false
FORWARD_HEADERS_STRATEGY=none
